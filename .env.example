# zcode-hub 环境变量样例 —— 复制为 .env 后按需修改；.env 永不入库

# ── 服务 ──
ZCODE_PORT=3000
ZCODE_HOST=0.0.0.0
ZCODE_DATA_DIR=data

# ── 鉴权 ──
# 后台管理密码（首次启动写入 meta 表，之后以数据库为准）
ZCODE_ADMIN_KEY=change-me
# 网关 API Key 不在这里配：在后台「客户端接入」页生成，落 api_keys 表

# ── 上游（一般无需改动）──
# ZAI_UPSTREAM_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# BIGMODEL_UPSTREAM_URL=https://open.bigmodel.cn/api/anthropic/v1/messages
# UPSTREAM_USER_AGENT=ZCode/3.0.1

# ── 验证码求解（Node 子进程）──
ZCODE_NODE_PATH=node
# ZCODE_CAPTCHA_RETRIES=4
# ZCODE_CAPTCHA_TIMEOUT=40
# CAPTCHA_CACHE_TTL=45000

# ── 额度监控 ──
# ZCODE_QUOTA_REFRESH_INTERVAL=60
# ZCODE_COOLING_SECONDS=300

# ── 账号并发 ──
# 单账号并发上限（0 = 不限）；运行时可在后台设置改，以库为准
# ZCODE_ACCOUNT_CONCURRENCY=2

# ── 套餐自动领取轮 ──
# 周期对全部 JWT 账号轮一遍激活上报+查询+领取（0 = 关闭）；运行时可在后台设置改，以库为准
# ZCODE_CLAIM_ROUND_INTERVAL=600

# ── 模型白名单 ──
# manual=只认后台手填名单（默认）/ static=只认内置名单 / dynamic=只认账号额度推导 /
# hybrid=内置 ∪ 额度并集。手填名单本身存在 meta 表，后台设置页填；名单为空一律回落 static
# ZCODE_MODEL_WHITELIST_MODE=manual
# 上游 3006「该套餐不含此模型」按账号钉格子的时长（秒）；过期自动失效
# ZCODE_MODEL_DENIAL_TTL=604800

# ── 官方定价页拉取 ──
# 条件 GET docs 定价页作为计价中间层（0 = 关闭，默认关）。只读公开文档站，
# 不携带任何账号身份头；失败一律保留上一份，不影响内置与后台覆盖两层
# ZCODE_PRICING_PULL_INTERVAL=0

# ── 秘钥类（不落盘、不入日志）──
# ZSW_PASSWORD=            # .zsb 导出口令（与 zcode-switch 脚本兼容）
# ZCODE_BUNDLE_PASSWORD=   # 备选口令变量
# ZCODE_MASTER_SECRET=     # M1：凭证落库加密主秘钥
